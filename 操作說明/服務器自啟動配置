#安裝 screen
sudo apt install screen -y

# 1. 創建服務檔案
sudo tee /etc/systemd/system/minecraft.service << 'EOF'

[Unit]
Description=Minecraft Java + Bedrock Server
After=network.target

[Service]
User=rr901037
WorkingDirectory=/home/rr901037/minecraft-server
#新的：在背景創建名為 "minecraft" 的 session ， screen 裡面啟動 Java 
ExecStart=/usr/bin/screen -DmS minecraft /usr/bin/java -Xmx7G -Xms1G -jar server.jar nogui
ExecStop=/usr/bin/screen -S minecraft -X stuff "stop\n"

# 崩潰自動重啟
Restart=always
RestartSec=10

# 最多重啟 5 次（5 分鐘內）
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
EOF

# 2. 重新載入並啟用
sudo systemctl daemon-reload
sudo systemctl enable minecraft
sudo systemctl start minecraft

# 3. 確認狀態
sudo systemctl status minecraft