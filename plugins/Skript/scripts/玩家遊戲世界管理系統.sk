# ============================================
# 玩家遊戲世界系統 (一般玩家可用)
# 依賴: Skript / Multiverse-Core 5.x / Multiverse-Inventories / Multiverse-NetherPortals / VoidGen / LuckPerms / WorldEdit
#
# 全域變數結構:
#   {玩家世界::計數器}                          → 流水號計數器
#   {玩家世界::名稱對應::<中文名>}              → 內部名 (pw_N)        ※只存主世界
#   {玩家世界::反向對應::<pw_N>}                → 中文名               ※只存主世界
#   {玩家世界::創造者::<pw_N>}                  → 創造者玩家名         ※只存主世界
#   {玩家世界::共同編輯者::<pw_N>::<玩家名>}    → true (是共同編輯者)  ※只存主世界
#   {玩家世界::訪問次數::<pw_N>}                → 累計訪問次數
#   {玩家世界::訪問玩家::<pw_N>::<玩家名>}      → true (該玩家曾訪問過)
#   {玩家世界::訪問玩家數::<pw_N>}              → 不重複訪問人數
#
# 每個玩家世界實際包含三個 Multiverse 世界 (MVNP 命名慣例):
#   pw_N            → 主世界 (overworld)
#   pw_N_nether     → 下界   (nether)
#   pw_N_the_end    → 終界   (the_end)
#   三者皆 VoidGen 空島,(0,64,0) 各放一格基岩,出生點 0.5,65,0.5
#   傳送門以 MVNP 互鎖,絕不通往主線 world_nether / world_the_end
#   背包/裝備/副手/終界箱: 三維度共用一組,與主線隔離
#   權限與身份判斷一律先用 pw_base() 還原成主世界名
# ============================================

options:
    每人世界上限: 0
    # 基岩玩家(Floodgate)名稱前綴; 預設 "."。若你關閉了 Floodgate 前綴, 把這裡留空 (但建議至少保留 . )
    基岩前綴: .
    # 是否在基岩玩家進入自己世界時自動刷新指令樹 (修正 //copy 顯示未知指令)。true / false
    啟用基岩指令刷新: true

function canEdit(p: text, w: text) :: boolean:
    if {玩家世界::創造者::%{_w}%} is {_p}:
        return true
    if {玩家世界::共同編輯者::%{_w}%::%{_p}%} is true:
        return true
    return false

function countWorlds(p: text) :: number:
    set {_n} to 0
    loop {玩家世界::創造者::*}:
        if loop-value is {_p}:
            add 1 to {_n}
    return {_n}

# 還原維度後綴 → 主世界名 (pw_N_nether / pw_N_the_end → pw_N)
function pw_base(w: text) :: text:
    set {_b} to {_w}
    replace "_nether" with "" in {_b}
    replace "_the_end" with "" in {_b}
    return {_b}

# 名稱 → UUID 解析。基岩(Floodgate)名稱含前綴(如 .Poet_Canary), LuckPerms 不接受名稱格式,
# 必須改用 UUID。此表由 on join 維護 (見檔案下方)。查不到就回傳原名 (Java 離線玩家用名稱也能解析)。
function uuidOf(name: text) :: text:
    if {玩家世界::UUID::%{_name}%} is set:
        return {玩家世界::UUID::%{_name}%}
    return {_name}

# ===== 常駐發放編輯權 (A 方案核心) =====
# 一次寫好 worldedit + gamemode bypass 的「永久」節點, 並用 world= context 鎖在該世界三維度。
# 因為帶 world= context, 玩家一旦離開該世界 context 立即不匹配 → 權限自動失效,
# 不依賴任何「離開事件」去收回; 殘留節點也不會套到別的世界。
# 所有 lp 指令一律用 UUID, 以相容 Floodgate 基岩玩家。
function grantEdit(p: text, base: text):
    set {_id} to uuidOf({_p})
    # 含 "." = 尚未上線過的基岩名, 無法解析成 UUID; 跳過, 等他上線時由 on join 補發
    if {_id} does not contain ".":
        set {_n} to "%{_base}%"
        set {_nether} to "%{_base}%_nether"
        set {_end} to "%{_base}%_the_end"
        execute console command "lp user %{_id}% permission set worldedit.* true world=%{_n}%"
        execute console command "lp user %{_id}% permission set multiverse.bypass.gamemode.%{_n}% true world=%{_n}%"
        execute console command "lp user %{_id}% permission set minecraft.command.gamemode true world=%{_n}%"
        execute console command "lp user %{_id}% permission set worldedit.* true world=%{_nether}%"
        execute console command "lp user %{_id}% permission set multiverse.bypass.gamemode.%{_nether}% true world=%{_nether}%"
        execute console command "lp user %{_id}% permission set minecraft.command.gamemode true world=%{_nether}%"
        execute console command "lp user %{_id}% permission set worldedit.* true world=%{_end}%"
        execute console command "lp user %{_id}% permission set multiverse.bypass.gamemode.%{_end}% true world=%{_end}%"
        execute console command "lp user %{_id}% permission set minecraft.command.gamemode true world=%{_end}%"

# 撤銷常駐編輯權 (刪世界 / 移除共同編輯者時呼叫; 與 grantEdit 對應, 用 unset 而非 unsettemp)
function revokeEdit(p: text, base: text):
    set {_id} to uuidOf({_p})
    if {_id} does not contain ".":
        set {_n} to "%{_base}%"
        set {_nether} to "%{_base}%_nether"
        set {_end} to "%{_base}%_the_end"
        execute console command "lp user %{_id}% permission unset worldedit.* world=%{_n}%"
        execute console command "lp user %{_id}% permission unset multiverse.bypass.gamemode.%{_n}% world=%{_n}%"
        execute console command "lp user %{_id}% permission unset minecraft.command.gamemode world=%{_n}%"
        execute console command "lp user %{_id}% permission unset worldedit.* world=%{_nether}%"
        execute console command "lp user %{_id}% permission unset multiverse.bypass.gamemode.%{_nether}% world=%{_nether}%"
        execute console command "lp user %{_id}% permission unset minecraft.command.gamemode world=%{_nether}%"
        execute console command "lp user %{_id}% permission unset worldedit.* world=%{_end}%"
        execute console command "lp user %{_id}% permission unset multiverse.bypass.gamemode.%{_end}% world=%{_end}%"
        execute console command "lp user %{_id}% permission unset minecraft.command.gamemode world=%{_end}%"

# 套用一個維度的標準設定 (僅同步指令; 世界須已載入)
function pw_setup(w: text):
    set {_世界} to world {_w}
    if {_世界} is not set:
        stop
    set block at location(0, 64, 0, {_世界}) to bedrock
    execute console command "mv setspawn %{_w}%:0.5,65,0.5"
    execute console command "mv modify %{_w}% set gamemode adventure"
    execute console command "mv entity-spawn-config modify %{_w}% monster set spawn false"
    execute console command "mv entity-spawn-config modify %{_w}% animal set spawn false"
    execute console command "mv gamerule set advance_time false %{_w}%"
    execute console command "mv gamerule set advance_weather false %{_w}%"
    execute console command "mv gamerule set spawn_mobs false %{_w}%"
    execute console command "execute in minecraft:%{_w}% run minecraft:weather clear"
    execute console command "execute in minecraft:%{_w}% run minecraft:time set day"

# ===== 建立玩家遊戲世界 =====
command /玩家遊戲世界建立 <text>:
    description: 建立你自己的遊戲世界
    executable by: players
    trigger:
        set {_中文名} to arg-1
        if {_中文名} contains " ":
            send "&c世界名稱不可包含空格！"
            stop
        # 檢查上限
        if {@每人世界上限} is not 0:
            set {_已有} to countWorlds(player's name)
            if {_已有} is greater than or equal to {@每人世界上限}:
                set {_上限文字} to "{@每人世界上限}"
                send "&c你已建立 &e%{_已有}% &c個世界,達到上限 &e%{_上限文字}%&c！"
                send "&7請先用 &f/玩家遊戲世界刪除 <名稱> &7刪除舊世界。"
                stop
        if {玩家世界::名稱對應::%{_中文名}%} is set:
            send "&c世界 &e%{_中文名}% &c已經存在！"
            stop
        if {玩家世界::計數器} is not set:
            set {玩家世界::計數器} to 0
        set {_流水號} to {玩家世界::計數器} + 1
        # 立刻佔用流水號,避免兩人同時建立時搶到同一個 pw_N (失敗造成的號碼斷層無妨)
        set {玩家世界::計數器} to {_流水號}
        set {_世界名} to "pw_%{_流水號}%"
        set {_下界名} to "%{_世界名}%_nether"
        set {_終界名} to "%{_世界名}%_the_end"
        send "&a▶ 正在建立 &e%{_中文名}% &7(內部名: %{_世界名}%)&a..."

        # ===== 建立三個維度 =====
        send "&7  ├─ 建立主世界..."
        execute console command "mv create %{_世界名}% normal -g VoidGen"
        wait 3 seconds
        set {_世界} to world {_世界名}
        if {_世界} is not set:
            send "&c❌ 主世界建立失敗！"
            stop
        send "&7  ├─ 建立下界..."
        execute console command "mv create %{_下界名}% nether -g VoidGen"
        wait 3 seconds
        send "&7  └─ 建立終界..."
        execute console command "mv create %{_終界名}% the_end -g VoidGen"
        wait 3 seconds
        if world {_下界名} is not set:
            send "&c❌ 下界建立失敗,正在回收..."
            execute console command "mv delete %{_世界名}% --remove-players"
            wait 1 second
            execute console command "mv confirm"
            stop
        if world {_終界名} is not set:
            send "&c❌ 終界建立失敗,正在回收..."
            execute console command "mv delete %{_下界名}% --remove-players"
            wait 1 second
            execute console command "mv confirm"
            execute console command "mv delete %{_世界名}% --remove-players"
            wait 1 second
            execute console command "mv confirm"
            stop

        # ===== 全部成功,寫入對應表 (只存主世界) =====
        set {玩家世界::名稱對應::%{_中文名}%} to {_世界名}
        set {玩家世界::反向對應::%{_世界名}%} to {_中文名}
        set {玩家世界::創造者::%{_世界名}%} to player's name

        # ===== 常駐發放創造者編輯權 (A: 改為永久 + world context, 不再靠 world change settemp) =====
        grantEdit(player's name, {_世界名})

        # ===== 套用三維度標準設定 =====
        pw_setup({_世界名})
        pw_setup({_下界名})
        pw_setup({_終界名})
        wait 2 ticks

        # ===== 傳送門連結 (鎖在本世界內部) =====
        execute console command "mvnp link nether %{_世界名}% %{_下界名}%"
        execute console command "mvnp link end %{_世界名}% %{_終界名}%"
        execute console command "mvnp link nether %{_下界名}% %{_世界名}%"
        execute console command "mvnp link end %{_終界名}% %{_世界名}%"
        wait 2 ticks

        # ===== 背包完全隔離設定 (三維度同一群組) =====
        execute console command "mvinv create-group %{_世界名}% %{_世界名}%,%{_下界名}%,%{_終界名}% all"
        wait 5 ticks
        execute console command "mvinv reload"
        wait 5 ticks

        send "&a✔ 世界建立完成！"
        send "&7  ├─ 名稱: &e%{_中文名}% &7(內部: %{_世界名}%)"
        send "&7  ├─ 維度: &f主世界 / 下界 / 終界 (各一格空島)"
        send "&7  ├─ 創造者: &b%player's name%"
        send "&7  └─ 你在此世界可使用: &f/玩家遊戲世界個人模式 &7、&f小木斧"
        send "&b▶ 正在傳送..."
        make console execute command "tppos %player's name% 0.5 65 0.5 0 0 %{_世界名}%"

# ===== 刪除玩家遊戲世界 =====
command /玩家遊戲世界刪除 <text>:
    description: 刪除你自己的遊戲世界
    executable by: players
    trigger:
        set {_中文名} to arg-1
        set {_世界名} to {玩家世界::名稱對應::%{_中文名}%}
        if {_世界名} is not set:
            send "&c世界 &e%{_中文名}% &c不存在！"
            stop
        if {玩家世界::創造者::%{_世界名}%} is not player's name:
            if player does not have permission "gameworld.admin":
                send "&c你不是此世界的創造者,無法刪除！"
                stop
        set {_下界名} to "%{_世界名}%_nether"
        set {_終界名} to "%{_世界名}%_the_end"
        send "&a▶ 正在刪除世界 &e%{_中文名}%&a..."
        # ===== 步驟 1: 把三個維度的玩家踢回主世界 =====
        loop all players:
            set {_pw} to "%loop-player's world%"
            if {_pw} is {_世界名} or {_下界名} or {_終界名}:
                # worldedit / gamemode 改為常駐節點, 由下方 revokeEdit 統一撤銷; 此處只清 essentials 暫時節點
                execute console command "lp user %loop-player's uuid% permission unsettemp essentials.teleport.timer.bypass world=%{_pw}%"
                execute console command "lp user %loop-player's uuid% permission unsettemp essentials.teleport.cooldown.bypass world=%{_pw}%"
                set loop-player's gamemode to adventure
                execute console command "spawn %loop-player%"
                send "&e你所在的世界 &c%{_中文名}% &e已被刪除,已將你傳送回主世界。" to loop-player
        wait 10 ticks
        # ===== 步驟 2: 解除傳送門連結 =====
        execute console command "mvnp unlink nether %{_世界名}%"
        execute console command "mvnp unlink end %{_世界名}%"
        execute console command "mvnp unlink nether %{_下界名}%"
        execute console command "mvnp unlink end %{_終界名}%"
        # ===== 步驟 3: 移出背包群組 =====
        execute console command "mvinv delete-group %{_世界名}%"
        # ===== 步驟 4: 依序刪除三個世界 =====
        execute console command "mv delete %{_終界名}% --remove-players"
        wait 1 second
        execute console command "mv confirm"
        wait 1 second
        execute console command "mv delete %{_下界名}% --remove-players"
        wait 1 second
        execute console command "mv confirm"
        wait 1 second
        execute console command "mv delete %{_世界名}% --remove-players"
        wait 2 seconds
        execute console command "mv confirm"
        wait 1 second
        # ===== 步驟 5: 清除對應表 =====
        # 先撤銷創造者與所有共同編輯者的常駐編輯權 (A: 對應 grantEdit), 必須趕在刪除變數前取得名單
        revokeEdit({玩家世界::創造者::%{_世界名}%}, {_世界名})
        loop {玩家世界::共同編輯者::%{_世界名}%::*}:
            revokeEdit(loop-index, {_世界名})
        delete {玩家世界::名稱對應::%{_中文名}%}
        delete {玩家世界::反向對應::%{_世界名}%}
        delete {玩家世界::創造者::%{_世界名}%}
        delete {玩家世界::共同編輯者::%{_世界名}%::*}
        delete {玩家世界::訪問次數::%{_世界名}%}
        delete {玩家世界::訪問玩家::%{_世界名}%::*}
        delete {玩家世界::訪問玩家數::%{_世界名}%}
        send "&a✔ 已刪除世界 &e%{_中文名}% &7(主世界/下界/終界)"


# ===== 列表 / 傳送 =====
command /玩家遊戲世界列表 [<text>]:
    description: 查看玩家遊戲世界列表並傳送
    trigger:
        if arg-1 is set:
            set {_世界名} to {玩家世界::名稱對應::%arg-1%}
            if {_世界名} is not set:
                send "&c❌ 世界 &e%arg-1% &c不存在！"
                stop
            set {_世界} to world {_世界名}
            if {_世界} is not set:
                send "&c❌ 世界資料異常！"
                stop
            make console execute command "tppos %player's name% 0.5 65 0.5 0 0 %{_世界名}%"
            send "&a✔ 正在傳送至 &e%arg-1%&a！"
        else:
            # ===== 列表模式 - 按訪問次數由高至低排序 =====
            delete {_排序清單::*}
            loop {玩家世界::名稱對應::*}:
                set {_顯示名} to loop-index
                set {_內部名} to loop-value
                set {_次數} to {玩家世界::訪問次數::%{_內部名}%} ? 0
                set {_補零次數} to "%{_次數}%"
                loop 10 times:
                    if length of {_補零次數} < 10:
                        set {_補零次數} to "0%{_補零次數}%"
                set {_key} to "%{_補零次數}%|%{_顯示名}%"
                set {_排序清單::%{_key}%} to {_內部名}
            set {_有世界} to false
            send "&6&m──────&r &e玩家遊戲世界列表 &7(訪問熱度排序) &6&m──────"
            set {_keys::*} to indexes of {_排序清單::*}
            loop reversed {_keys::*}:
                set {_key} to loop-value
                set {_內部名} to {_排序清單::%{_key}%}
                set {_中文名} to {玩家世界::反向對應::%{_內部名}%}
                set {_創造者} to {玩家世界::創造者::%{_內部名}%}
                set {_次數} to {玩家世界::訪問次數::%{_內部名}%} ? 0
                set {_人數} to {玩家世界::訪問玩家數::%{_內部名}%} ? 0
                send formatted "&e ▸ &a%{_中文名}%<command:/玩家遊戲世界列表 %{_中文名}%>&7[&b傳送&7]<reset> &7- 創造者: &b%{_創造者}% &7- 訪問: &e%{_次數}% &7次 / &e%{_人數}% &7人"
                set {_有世界} to true
            if {_有世界} is false:
                send "&c目前沒有任何玩家遊戲世界！"
            send "&7使用 &f/玩家遊戲世界建立 <名稱> &7建立你的世界"
            send "&6&m────────────────────────────"

# ===== 切換創造/冒險模式 =====
command /玩家遊戲世界個人模式:
    description: 在你的世界中個人切換創造/冒險模式
    executable by: players
    trigger:
        set {_世界名} to "%player's world%"
        if {_世界名} does not start with "pw_":
            send "&c此指令只能在玩家遊戲世界中使用！"
            stop
        # 還原成主世界名再判斷編輯權 (下界/終界也適用)
        set {_基礎} to pw_base({_世界名})
        if canEdit(player's name, {_基礎}) is false:
            send "&c你沒有共同編輯此世界的權限！"
            stop
        if player's gamemode is adventure:
            set player's gamemode to creative
            send "&a✔ 已切換為 &e創造模式"
        else:
            set player's gamemode to adventure
            send "&a✔ 已切換為 &e冒險模式"

# ===== 新增共同編輯者 =====
command /玩家遊戲世界共同編輯新增 <text> <text>:
    description: 為你的世界新增共同編輯者
    usage: &c/玩家遊戲世界共同編輯新增 <世界名> <玩家名>
    executable by: players
    trigger:
        set {_中文名} to arg-1
        set {_目標} to arg-2
        set {_世界名} to {玩家世界::名稱對應::%{_中文名}%}
        if {_世界名} is not set:
            send "&c世界 &e%{_中文名}% &c不存在！"
            stop
        if {玩家世界::創造者::%{_世界名}%} is not player's name:
            send "&c只有創造者才能管理共同編輯者！"
            stop
        if {_目標} is player's name:
            send "&c你已經是創造者,不能把自己加為共同編輯者！"
            stop
        if {玩家世界::共同編輯者::%{_世界名}%::%{_目標}%} is true:
            send "&e%{_目標}% &c已經是此世界的共同編輯者！"
            stop
        set {玩家世界::共同編輯者::%{_世界名}%::%{_目標}%} to true
        # A: 直接常駐發放編輯權 (三維度), 不論對方在不在線; 帶 world context, 不在此世界時自動失效
        grantEdit({_目標}, {_世界名})
        send "&a✔ 已新增 &e%{_目標}% &a為 &e%{_中文名}% &a的共同編輯者！"
        # 若該玩家在線, 通知他; 若他正好在此世界(任一維度)且為基岩玩家, 順手刷新指令樹
        loop all players:
            if loop-player's name is {_目標}:
                send "&a你已被 &b%player's name% &a加為 &e%{_中文名}% &a的共同編輯者!" to loop-player
                set {_目標世界} to "%loop-player's world%"
                if pw_base({_目標世界}) is {_世界名}:
                    if {@啟用基岩指令刷新} is true:
                        if loop-player's name starts with "{@基岩前綴}":
                            set {_原模式} to loop-player's gamemode
                            if loop-player's gamemode is creative:
                                set loop-player's gamemode to adventure
                            else:
                                set loop-player's gamemode to creative
                            wait 2 ticks
                            set loop-player's gamemode to {_原模式}

# ===== 移除共同編輯者 =====
command /玩家遊戲世界共同編輯移除 <text> <text>:
    description: 從你的世界移除共同編輯者
    usage: &c/玩家遊戲世界共同編輯移除 <世界名> <玩家名>
    executable by: players
    trigger:
        set {_中文名} to arg-1
        set {_目標} to arg-2
        set {_世界名} to {玩家世界::名稱對應::%{_中文名}%}
        if {_世界名} is not set:
            send "&c世界 &e%{_中文名}% &c不存在！"
            stop
        if {玩家世界::創造者::%{_世界名}%} is not player's name:
            send "&c只有創造者才能管理共同編輯者！"
            stop
        if {玩家世界::共同編輯者::%{_世界名}%::%{_目標}%} is not set:
            send "&e%{_目標}% &c不是此世界的共同編輯者！"
            stop
        set {_下界名} to "%{_世界名}%_nether"
        set {_終界名} to "%{_世界名}%_the_end"
        delete {玩家世界::共同編輯者::%{_世界名}%::%{_目標}%}
        # A: 無條件撤銷常駐編輯權 (三維度), 離線玩家也照樣撤銷
        revokeEdit({_目標}, {_世界名})
        send "&a✔ 已將 &e%{_目標}% &a從 &e%{_中文名}% &a的共同編輯者中移除！"
        loop all players:
            if loop-player's name is {_目標}:
                set {_目標世界} to "%loop-player's world%"
                if pw_base({_目標世界}) is {_世界名}:
                    set loop-player's gamemode to adventure
                    send "&c你已被移除共同編輯權限" to loop-player

# ===== 查看共同編輯者列表 =====
command /玩家遊戲世界共同編輯列表 <text>:
    description: 查看世界的共同編輯者列表
    trigger:
        set {_中文名} to arg-1
        set {_世界名} to {玩家世界::名稱對應::%{_中文名}%}
        if {_世界名} is not set:
            send "&c世界 &e%{_中文名}% &c不存在！"
            stop
        send "&6&m──&r &e%{_中文名}% &7的共同編輯者 &6&m──"
        send "&7創造者: &b%{玩家世界::創造者::%{_世界名}%}%"
        set {_有共同編輯者} to false
        loop {玩家世界::共同編輯者::%{_世界名}%::*}:
            send "&7共同編輯者: &a%loop-index%"
            set {_有共同編輯者} to true
        if {_有共同編輯者} is false:
            send "&7(目前沒有共同編輯者)"
        send "&6&m──────────────────"


# ===== 玩家切換世界時自動配發/收回權限 (使用 LuckPerms) =====
on world change:
    set {_新世界} to "%player's world%"
    set {_舊世界} to "%event-world%"
    # 離開玩家世界(任一維度) - 撤銷該維度權限
    if {_舊世界} contains "pw_":
        # worldedit / gamemode 為常駐 + world context, 離開後 context 不匹配即自動失效, 無需在此撤銷
        #清除去除等待時間的代碼
        execute console command "lp user %player's uuid% permission unsettemp essentials.commandcooldowns.bypass world=%{_舊世界}%"
        execute console command "lp user %player's uuid% permission unsettemp essentials.teleport.timer.bypass world=%{_舊世界}%"
        execute console command "lp user %player's uuid% permission unsettemp essentials.teleport.cooldown.bypass world=%{_舊世界}%"
        # 只有「真正離開」玩家世界(去到非 pw_ 世界)才強制回冒險; 維度間移動保留模式
        if {_新世界} does not contain "pw_":
            if player's gamemode is creative:
                set player's gamemode to adventure
    # 進入玩家世界(任一維度)
    if {_新世界} contains "pw_":
        # 還原主世界名,用於身份判斷與統計
        set {_基礎} to pw_base({_新世界})
        set {_中文名} to {玩家世界::反向對應::%{_基礎}%}
        #繞過/home等待
        execute console command "lp user %player's uuid% permission settemp essentials.commandcooldowns.bypass true 1d world=%{_新世界}%"
        # 所有人(含訪客)都可繞過 /spawn 等待 (目前維度)
        execute console command "lp user %player's uuid% permission settemp essentials.teleport.timer.bypass true 1d world=%{_新世界}%"
        execute console command "lp user %player's uuid% permission settemp essentials.teleport.cooldown.bypass true 1d world=%{_新世界}%"
        # 訪問統計: 只在進入「主世界維度」時計算,避免跨維度重複 (排除創造者與共同編輯者)
        if {_新世界} is {_基礎}:
            if {玩家世界::創造者::%{_基礎}%} is not player's name:
                if {玩家世界::共同編輯者::%{_基礎}%::%player's name%} is not set:
                    if {玩家世界::訪問次數::%{_基礎}%} is not set:
                        set {玩家世界::訪問次數::%{_基礎}%} to 0
                    add 1 to {玩家世界::訪問次數::%{_基礎}%}
                    if {玩家世界::訪問玩家::%{_基礎}%::%player's name%} is not set:
                        set {玩家世界::訪問玩家::%{_基礎}%::%player's name%} to true
                        if {玩家世界::訪問玩家數::%{_基礎}%} is not set:
                            set {玩家世界::訪問玩家數::%{_基礎}%} to 0
                        add 1 to {玩家世界::訪問玩家數::%{_基礎}%}
        # 身份判斷 (編輯權已是常駐節點, 這裡不再 settemp; 只負責歡迎訊息與訪客模式)
        set {_可編輯} to false
        # 創造者
        if {玩家世界::創造者::%{_基礎}%} is player's name:
            set {_可編輯} to true
            if {_新世界} is {_基礎}:
                send "&a✔ 歡迎回來,這裡是你建立的 &e%{_中文名}%"
                send "&7  ▸ &f/玩家遊戲世界個人模式 &7- 切換創造/冒險"
                send "&7  ▸ &f小木斧 &7- WorldEdit 區域選擇 (僅限此世界)"
        # 共同編輯者
        else if {玩家世界::共同編輯者::%{_基礎}%::%player's name%} is true:
            set {_可編輯} to true
            if {_新世界} is {_基礎}:
                send "&a✔ 你是 &e%{_中文名}% &a的共同編輯者"
                send "&7  ▸ &f/玩家遊戲世界個人模式 &7- 切換創造/冒險"
                send "&7  ▸ &f小木斧 &7- WorldEdit 區域選擇 (僅限此世界)"
        # 訪客
        else:
            set player's gamemode to adventure
            if {_新世界} is {_基礎}:
                send "&7你正在參觀 &e%{_中文名}%&7,由 &b%{玩家世界::創造者::%{_基礎}%}% &7建立"
        # ===== 進入自己/共編世界 → 直接用 UUID 發編輯權 (本維度, settemp) =====
        # 用 %player's uuid% 直發 (與已驗證可用的 essentials bypass 同一條路徑), 不經過名稱→UUID 對照表,
        # 因此對基岩玩家一定生效。常駐 grantEdit 仍在(建立/共編/登入時預設), 此處為每次進入的可靠保險。
        # 排在 B 刷新之前: 先發權限, 再刷新指令樹, 這樣基岩重送的指令樹才會包含 //copy 等。
        if {_可編輯} is true:
            execute console command "lp user %player's uuid% permission settemp worldedit.* true 1d world=%{_新世界}%"
            execute console command "lp user %player's uuid% permission settemp multiverse.bypass.gamemode.%{_新世界}% true 1d world=%{_新世界}%"
            execute console command "lp user %player's uuid% permission settemp minecraft.command.gamemode true 1d world=%{_新世界}%"
        # ===== B: 基岩玩家(Floodgate)強制刷新指令樹 =====
        # 權限發完後, 短暫切換遊戲模式逼 Geyser 重送指令樹, 讓 //copy 等出現在基岩指令列表。
        # 只對「有編輯權的基岩玩家」做, 訪客不受影響。
        if {@啟用基岩指令刷新} is true:
            if {_可編輯} is true:
                if player's name starts with "{@基岩前綴}":
                    set {_原模式} to player's gamemode
                    wait 12 ticks
                    if "%player's world%" contains "pw_":
                        if player's gamemode is creative:
                            set player's gamemode to adventure
                        else:
                            set player's gamemode to creative
                        wait 2 ticks
                        set player's gamemode to {_原模式}

on teleport:
    set {_舊世界} to "%event-world%"
    if {_舊世界} contains "pw_":
        # 延遲 5 ticks 讓傳送完成後再檢查
        wait 5 ticks
        if "%player's world%" does not contain "pw_":
            # worldedit / gamemode 為常駐 + world context, 離開後自動失效, 無需撤銷
            #清除去除等待時間的代碼
            execute console command "lp user %player's uuid% permission unsettemp essentials.commandcooldowns.bypass world=%{_舊世界}%"
            execute console command "lp user %player's uuid% permission unsettemp essentials.teleport.timer.bypass world=%{_舊世界}%"
            execute console command "lp user %player's uuid% permission unsettemp essentials.teleport.cooldown.bypass world=%{_舊世界}%"
            if player's gamemode is creative:
                set player's gamemode to adventure

# ===== 登入: 維護 UUID 對照表 + 補發常駐編輯權 =====
# 1) 記錄玩家名稱→UUID (Floodgate 基岩名含 ".", lp 只認 UUID, 全靠這張表)
# 2) 掃過所有世界, 確保本玩家對其「創造 / 共同編輯」的世界都有常駐編輯權
#    這同時涵蓋了: 升級遷移、離線時被加為共編者、Floodgate UUID 對照建立
on join:
    set {玩家世界::UUID::%player's name%} to "%player's uuid%"
    loop {玩家世界::創造者::*}:
        set {_w} to loop-index
        if loop-value is player's name:
            grantEdit(player's name, {_w})
        else if {玩家世界::共同編輯者::%{_w}%::%player's name%} is true:
            grantEdit(player's name, {_w})

# ===== 手動刷新指令樹 (B 的後備手段) =====
# 若基岩玩家進世界後 //copy 仍顯示未知指令, 自己跑這個指令逼客戶端重新整理。
command /玩家遊戲世界刷新指令:
    description: 若小木斧指令在基岩版顯示未知,用此重新整理指令列表
    executable by: players
    trigger:
        if "%player's world%" does not contain "pw_":
            send "&c此指令只能在玩家遊戲世界中使用！"
            stop
        set {_原模式} to player's gamemode
        if player's gamemode is creative:
            set player's gamemode to adventure
        else:
            set player's gamemode to creative
        wait 2 ticks
        set player's gamemode to {_原模式}
        send "&a✔ 已重新整理指令列表,請再試一次小木斧指令 (例如 &f//copy&a)"
        send "&7若仍顯示未知, 請退出重新連線一次。"

# ===== 一次性遷移指令 (僅管理員) =====
# 從舊版(靠 world change 臨時發權)升級到本版(常駐發權)後, 跑一次這個指令,
# 替「所有已存在世界」的創造者與共同編輯者補發常駐編輯權。跑完即可。
command /玩家遊戲世界重建權限:
    description: 升級後一次性: 替所有現存世界的創造者/共同編輯者補發常駐編輯權
    permission: gameworld.admin
    executable by: players
    trigger:
        # 先記錄所有「目前在線」玩家的 UUID, 讓在線者不必重連即可被補發 (離線者於下次登入自動補)
        loop all players:
            set {玩家世界::UUID::%loop-player's name%} to "%loop-player's uuid%"
        set {_數量} to 0
        loop {玩家世界::創造者::*}:
            set {_世界名} to loop-index
            set {_創造者} to loop-value
            grantEdit({_創造者}, {_世界名})
            add 1 to {_數量}
            loop {玩家世界::共同編輯者::%{_世界名}%::*}:
                grantEdit(loop-index-2, {_世界名})
        send "&a✔ 已替 &e%{_數量}% &a個世界重建創造者與共同編輯者的常駐編輯權。"
        send "&7尚未登入過的玩家會在下次上線時自動補發。"
        send "&7基岩玩家如仍顯示未知指令, 進世界後用 &f/玩家遊戲世界刷新指令&7。"

# ===== 基岩版 WorldEdit 指令橋接 (/wd) =====
# 基岩(Geyser)無法表示以 "//" 開頭的 WorldEdit 指令(指令名實際含 "/"),
# 所以 //wand //copy 等在基岩端一定顯示「未知或不完整的指令」——這是 Geyser 協定限制,
# 非權限問題(權限已用 UUID + world context 正確發放)。重連 / 刷新指令樹都救不了。
# 解法: 用一個普通名稱的指令, 由伺服器在後端代玩家執行 "//xxx", 完全繞過基岩指令樹。
#   /wd wand        → //wand
#   /wd copy        → //copy
#   /wd paste       → //paste
#   /wd set stone   → //set stone
#   /wd pos1        → //pos1
# Java 與基岩都可用。若 /wd 與其他插件衝突, 改下方指令名即可。
command /wd [<text>]:
    description: 代打 WorldEdit (//) 指令; 基岩版專用, 例如 /wd copy
    usage: &e用法: &f/wd <WorldEdit指令>  &7例如 /wd wand、/wd copy
    executable by: players
    trigger:
        if arg-1 is not set:
            send "&e用法: &f/wd <WorldEdit 指令>"
            send "&7例如  &f/wd wand  &7、&f/wd copy  &7、&f/wd paste  &7、&f/wd set stone"
            send "&7(等同於在 Java 版輸入 &f//wand&7、&f//copy&7 ...)"
            stop
        # 由伺服器代玩家在後端執行, 不經過基岩指令樹; 權限與選區照玩家本人計算
        make player execute command "//%arg-1%"

# ===== 診斷指令: 檢查目前世界的編輯權狀態 =====
# 玩家站在自己世界裡跑這個, 會直接顯示「實際生效」的 worldedit 權限 (已含 world context)。
# 這能一刀切開兩種可能: 權限沒生效 (要修發放/wildcard) vs 權限有了但 Geyser 沒吃到指令樹。
command /玩家遊戲世界檢查:
    description: 診斷你在目前世界的 WorldEdit 編輯權狀態 (同時印到伺服器終端)
    executable by: players
    trigger:
        delete {_報告::*}
        set {_w} to "%player's world%"
        set {_base} to pw_base({_w})
        add "===== 編輯權診斷 =====" to {_報告::*}
        add "名稱: %player's name%" to {_報告::*}
        add "UUID: %player's uuid%" to {_報告::*}
        add "目前世界: %{_w}% (主世界名 %{_base}%)" to {_報告::*}
        if {_w} contains "pw_":
            add "世界中文名: %{玩家世界::反向對應::%{_base}%}%" to {_報告::*}
            add "創造者: %{玩家世界::創造者::%{_base}%}%" to {_報告::*}
            if {玩家世界::創造者::%{_base}%} is player's name:
                add "身分: 創造者 (應有編輯權)" to {_報告::*}
            else if {玩家世界::共同編輯者::%{_base}%::%player's name%} is true:
                add "身分: 共同編輯者 (應有編輯權)" to {_報告::*}
            else:
                add "身分: 訪客 (本來就沒有編輯權, 屬正常)" to {_報告::*}
            add "----- 實際生效的 WorldEdit 權限 -----" to {_報告::*}
            if player has permission "worldedit.wand":
                add "worldedit.wand           = 有 (true)" to {_報告::*}
            else:
                add "worldedit.wand           = 沒有 (false)" to {_報告::*}
            if player has permission "worldedit.clipboard.copy":
                add "worldedit.clipboard.copy = 有 (true)" to {_報告::*}
            else:
                add "worldedit.clipboard.copy = 沒有 (false)" to {_報告::*}
            if player has permission "worldedit.region.set":
                add "worldedit.region.set     = 有 (true)" to {_報告::*}
            else:
                add "worldedit.region.set     = 沒有 (false)" to {_報告::*}
            if player has permission "worldedit.*":
                add "worldedit.* (萬用)        = 有 (true)" to {_報告::*}
            else:
                add "worldedit.* (萬用)        = 沒有 (false)" to {_報告::*}
        else:
            add "你不在玩家遊戲世界中, 無法判斷編輯權。" to {_報告::*}
        add "===== 診斷結束 =====" to {_報告::*}
        # 同時輸出到玩家畫面與伺服器終端 (終端方便複製)
        loop {_報告::*}:
            send "&7%loop-value%" to player
            send "[編輯權診斷] %loop-value%" to console
