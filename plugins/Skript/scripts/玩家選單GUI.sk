# ==========================================
#  自訂 GUI 選單系統 (雙觸發 + 多選單)
# ==========================================
#  觸發方式 1：蹲下時按 F (切換主副手)
#  指令     ：/menu /選單
# ==========================================

# ==========================================
# A. 選單內容
# ==========================================

function openMainMenu(p: player):
    set {_inv} to chest inventory with 3 rows named "主選單"
    set slot 0 of {_inv} to diamond named "&b傳送主城" with lore "&7點擊傳送到出生點"
    set slot 1 of {_inv} to white bed named "&e傳送回家" with lore "&7點擊傳送到你的床"
    # ===== 遊戲世界列表入口按鈕 =====
    set slot 2 of {_inv} to compass named "&a遊戲世界列表" with lore "&7查看並前往遊戲世界"
    # ===== 玩家遊戲世界列表入口按鈕 =====
    set slot 3 of {_inv} to compass named "&a玩家遊戲世界列表" with lore "&7查看並前往遊戲世界"
    set slot 4 of {_inv} to book named "&a更多功能" with lore "&7開啟功能選單"
    open {_inv} to {_p}

function openFunctionMenu(p: player):
    set {_inv} to chest inventory with 3 rows named "功能選單"
    set slot 0 of {_inv} to red stained glass pane named "&c返回" with lore "&7回到主選單"
    open {_inv} to {_p}

# ==========================================
# A-2. 新增：遊戲世界列表子選單
#   讀取「遊戲世界管理系統」的全域變數 {遊戲世界::名稱對應::*}
#   loop-index = 中文顯示名 / loop-value = 內部世界名 (game_N)
#   世界依序放在 slot 0,1,2... ；點擊時用 clicked slot 對回同順序的世界
# ==========================================

function openWorldListMenu(p: player):
    set {_inv} to chest inventory with 6 rows named "遊戲世界列表"
    # 逐一列出所有遊戲世界 (最多顯示 53 個，最後 1 格保留給返回按鈕)
    set {_i} to 0
    loop {遊戲世界::名稱對應::*}:
        if {_i} is smaller than 53:
            set {_顯示名} to loop-index
            set slot {_i} of {_inv} to grass block named "&a%{_顯示名}%" with lore "&7點擊傳送至此世界"
            add 1 to {_i}
    # 返回按鈕放在最後一個世界選項後面的下一格
    set {_返回槽位} to {_i}
    # 完全沒有世界時，保留原本的提示位置，返回按鈕放在提示後一格
    if {_i} is 0:
        set slot 22 of {_inv} to barrier named "&c目前沒有任何遊戲世界" with lore "&7請聯絡管理員建立"
        set {_返回槽位} to 23
    set slot {_返回槽位} of {_inv} to red stained glass pane named "&c返回" with lore "&7回到主選單"
    set {玩家選單GUI::世界列表返回槽位::%uuid of {_p}%} to {_返回槽位}
    open {_inv} to {_p}

# ==========================================
# A-3. 新增：玩家遊戲世界列表子選單
#   讀取「玩家遊戲世界系統」的全域變數 {玩家世界::名稱對應::*}
#   loop-index = 中文顯示名 / loop-value = 內部世界名 (pw_N)
#   點擊世界時執行：/玩家遊戲世界列表 <世界名稱>
# ==========================================

function openPlayerWorldGuideBook(p: player):
    # 建立虛擬成書，不放進玩家背包，直接打開
    # 注意：不要用 set book page 1，空書一開始是 0 頁，會造成 Invalid page number (1/0)
    # 改用 add ... to book pages of {_book} 逐頁新增，避免書無法開啟
    set {_book} to written book named "&e玩家遊戲世界使用手冊"
    set book title of {_book} to "玩家遊戲世界使用手冊"
    set book author of {_book} to "rr901037"
    add "&0&l玩家遊戲世界使用手冊%nl%%nl%&2/玩家遊戲世界建立 <名稱>%nl%&0建立自己的遊戲世界%nl%%nl%&2/玩家遊戲世界刪除 <名稱>%nl%&0刪除自己建立的世界%nl%%nl%&2/玩家遊戲世界個人模式%nl%&0切換玩家模式 創造/冒險%nl%&8限制建造者與共同編輯可用" to book pages of {_book}
    add "&2/玩家遊戲世界共同編輯新增 <世界名> <玩家名>%nl%&0新增共同編輯者%nl%%nl%&2/玩家遊戲世界共同編輯移除 <世界名> <玩家名>%nl%&0移除共同編輯者%nl%%nl%&2/玩家遊戲世界共同編輯列表 <世界名>%nl%&0查看共同編輯者" to book pages of {_book}
    add "&2//wand%nl%&0取得小木斧%nl%&8限共同編輯者或創造者可用" to book pages of {_book}
    open book {_book} to {_p}

function openPlayerWorldListMenu(p: player):
    set {_inv} to chest inventory with 6 rows named "玩家遊戲世界列表"
    # 第 1 格放玩家遊戲世界使用手冊，點擊後會自動打開書本
    set slot 0 of {_inv} to written book named "&e玩家遊戲世界使用手冊" with lore "&7點擊打開使用手冊"
    # 逐一列出所有玩家遊戲世界 (slot 0 保留給使用手冊，最多顯示 52 個，最後 1 格保留給返回按鈕)
    set {_i} to 1
    loop {玩家世界::名稱對應::*}:
        if {_i} is smaller than 53:
            set {_顯示名} to loop-index
            set {_內部名} to loop-value
            set {_創造者} to {玩家世界::創造者::%{_內部名}%} ? "未知"
            set {_次數} to {玩家世界::訪問次數::%{_內部名}%} ? 0
            set {_人數} to {玩家世界::訪問玩家數::%{_內部名}%} ? 0
            set slot {_i} of {_inv} to grass block named "&a%{_顯示名}%" with lore "&7創造者: &b%{_創造者}% &7- 訪問: &e%{_次數}% &7次 / &e%{_人數}% &7人" and "&7點擊傳送至此玩家世界"
            add 1 to {_i}
    # 返回按鈕放在最後一個世界選項後面的下一格
    set {_返回槽位} to {_i}
    # 完全沒有世界時，放提示，返回按鈕放在提示後一格
    if {_i} is 1:
        set slot 22 of {_inv} to barrier named "&c目前沒有任何玩家遊戲世界" with lore "&7請使用 /玩家遊戲世界建立 <名稱> 建立"
        set {_返回槽位} to 23
    set slot {_返回槽位} of {_inv} to red stained glass pane named "&c返回" with lore "&7回到主選單"
    set {玩家選單GUI::玩家世界列表返回槽位::%uuid of {_p}%} to {_返回槽位}
    open {_inv} to {_p}

# ==========================================
# B. 觸發方式
# ==========================================

on swap hand items:
    if player is sneaking:
        cancel event
        openMainMenu(player)

command /menu:
    trigger:
        openMainMenu(player)

command /選單:
    trigger:
        openMainMenu(player)

# ==========================================
# C. 點擊事件處理
# ==========================================
on inventory click:

    # ----- 主選單 -----
    if name of event-inventory is "主選單":
        cancel event
        if clicked inventory is event-inventory:
            if clicked slot is 0:
                close player's inventory
                send "&a[系統] 正在將你傳送到主城..." to player
                execute player command "/spawn"
            else if clicked slot is 1:
                close player's inventory
                execute player command "/home"
            else if clicked slot is 2:
                # 開啟遊戲世界列表
                wait 1 tick
                openWorldListMenu(player)
            else if clicked slot is 3:
                # 開啟玩家遊戲世界列表
                wait 1 tick
                openPlayerWorldListMenu(player)
            else if clicked slot is 4:
                # 更多功能
                wait 1 tick
                openFunctionMenu(player)

    # ----- 功能選單 -----
    if name of event-inventory is "功能選單":
        cancel event
        if clicked inventory is event-inventory:
            if clicked slot is 0:
                wait 1 tick
                openMainMenu(player)

    # ----- 遊戲世界列表 (新增) -----
    if name of event-inventory is "遊戲世界列表":
        cancel event
        if clicked inventory is event-inventory:
            if clicked slot is {玩家選單GUI::世界列表返回槽位::%uuid of player%}:
                # 返回主選單
                wait 1 tick
                openMainMenu(player)
            else:
                # 用「點到第幾格」對回同順序的世界清單 (與開選單時的放置順序一致)
                set {_j} to 0
                loop {遊戲世界::名稱對應::*}:
                    if {_j} is clicked slot:
                        set {_名稱} to loop-index
                    add 1 to {_j}
                # 有對到世界才傳送 (空格 / 返回鍵 / 提示框都不會對到)
                if {_名稱} is set:
                    close player's inventory
                    # 直接執行你確認可用的指令來前往
                    execute player command "/遊戲世界列表 %{_名稱}%"

    # ----- 玩家遊戲世界列表 (新增) -----
    if name of event-inventory is "玩家遊戲世界列表":
        cancel event
        if clicked inventory is event-inventory:
            if clicked slot is {玩家選單GUI::玩家世界列表返回槽位::%uuid of player%}:
                # 返回主選單
                wait 1 tick
                openMainMenu(player)
            else if clicked slot is 0:
                # 打開玩家遊戲世界使用手冊
                close player's inventory
                wait 1 tick
                openPlayerWorldGuideBook(player)
            else:
                # 用「點到第幾格」對回同順序的玩家世界清單
                # slot 0 是說明書，所以玩家世界從 slot 1 開始
                set {_j} to 1
                loop {玩家世界::名稱對應::*}:
                    if {_j} is clicked slot:
                        set {_名稱} to loop-index
                    add 1 to {_j}
                # 有對到世界才傳送
                if {_名稱} is set:
                    close player's inventory
                    execute player command "/玩家遊戲世界列表 %{_名稱}%"

# ==========================================
# D. 拖曳事件處理
# ==========================================
on inventory drag:
    if name of event-inventory is "主選單":
        cancel event
    if name of event-inventory is "功能選單":
        cancel event
    if name of event-inventory is "遊戲世界列表":
        cancel event
    if name of event-inventory is "玩家遊戲世界列表":
        cancel event
