# ============================================
# 傳送倒數系統（整合 EssentialsX）
# 支援：/home, /home <名稱>, /spawn
# ============================================
# 請將 EssentialsX 的 teleport-delay 設為 0
# ============================================

options:
    prefix: &e[&6傳送&e]
    delay: 30

# ============================================
# 監聽 /home 指令
# ============================================
on command "/home":
    cancel event
    
    if {countdown::%uuid of player%} is true:
        send "{@prefix} &c你已經在傳送中了！" to player
        stop
    
    set {_full} to full command
    set {_parts::*} to {_full} split by " "
    
    if size of {_parts::*} >= 2:
        set {_home} to {_parts::2}
        set {countdown.cmd::%uuid of player%} to "essentials:home %{_home}%"
        start_countdown(player, "家「%{_home}%」")
    else:
        set {countdown.cmd::%uuid of player%} to "essentials:home"
        start_countdown(player, "家")

# ============================================
# 監聽 /spawn 指令
# ============================================
on command "/spawn":
    cancel event
    
    if {countdown::%uuid of player%} is true:
        send "{@prefix} &c你已經在傳送中了！" to player
        stop
    
    set {countdown.cmd::%uuid of player%} to "essentials.spawn"
    start_countdown(player, "出生點")

# ============================================
# 倒數函數
# ============================================
function start_countdown(p: player, destination: text):
    set {_uuid} to uuid of {_p}
    
    set {countdown::%{_uuid}%} to true
    set {countdown.loc::%{_uuid}%} to location of {_p}
    
    send "{@prefix} &7請勿移動，否則傳送將被取消" to {_p}
    
    loop {@delay} times:
        if {countdown::%{_uuid}%} is not true:
            stop
        
        if {_p} is not online:
            clear_countdown({_uuid})
            stop
        
        # 檢查移動
        set {_current} to location of {_p}
        set {_start} to {countdown.loc::%{_uuid}%}
        set {_dx} to x-coordinate of {_current} - x-coordinate of {_start}
        set {_dz} to z-coordinate of {_current} - z-coordinate of {_start}
        set {_dist} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
        
        if {_dist} > 0.3:
            send "{@prefix} &c傳送已取消！&7（你移動了）" to {_p}
            send action bar "&c&l✗ 傳送已取消" to {_p}
            play sound "ENTITY_VILLAGER_NO" with volume 0.5 to {_p}
            clear_countdown({_uuid})
            stop
        
        set {_remaining} to {@delay} - loop-number + 1
        
        # 進度條
        set {_progress} to ""
        set {_filled} to ({_remaining} / {@delay}) * 20
        loop 20 times:
            if loop-number-2 <= {_filled}:
                set {_progress} to "%{_progress}%&a|"
            else:
                set {_progress} to "%{_progress}%&7|"
        
        send action bar "&e⏱ 傳送到%{_destination}%：&c&l%{_remaining}% &e秒 %{_progress}%" to {_p}
        
        if {_remaining} <= 5:
            play sound "BLOCK_NOTE_BLOCK_PLING" with volume 0.3 with pitch 1.5 to {_p}
        
        wait 0.82 second
    
    # 最終檢查
    if {countdown::%{_uuid}%} is not true:
        stop
    
    if {_p} is not online:
        clear_countdown({_uuid})
        stop
    
    # 再次檢查移動
    set {_current} to location of {_p}
    set {_start} to {countdown.loc::%{_uuid}%}
    set {_dx} to x-coordinate of {_current} - x-coordinate of {_start}
    set {_dz} to z-coordinate of {_current} - z-coordinate of {_start}
    set {_dist} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
    
    if {_dist} > 0.3:
        send "{@prefix} &c傳送已取消！&7（你移動了）" to {_p}
        play sound "ENTITY_VILLAGER_NO" with volume 0.5 to {_p}
        clear_countdown({_uuid})
        stop
    
    # 執行 EssentialsX 傳送
    set {_cmd} to {countdown.cmd::%{_uuid}%}
    make {_p} execute command {_cmd}
    
    send action bar "&a&l✓ 傳送成功！" to {_p}
    play sound "ENTITY_ENDERMAN_TELEPORT" with volume 0.5 to {_p}
    
    clear_countdown({_uuid})

# ============================================
# 清理函數
# ============================================
function clear_countdown(uuid: text):
    delete {countdown::%{_uuid}%}
    delete {countdown.loc::%{_uuid}%}
    delete {countdown.cmd::%{_uuid}%}

# ============================================
# 玩家受傷取消
# ============================================
on damage of player:
    if {countdown::%uuid of victim%} is true:
        send "{@prefix} &c傳送已取消！&7（受到攻擊）" to victim
        send action bar "&c&l✗ 傳送已取消" to victim
        play sound "ENTITY_VILLAGER_NO" with volume 0.5 to victim
        clear_countdown("%uuid of victim%")

# ============================================
# 玩家離開清理
# ============================================
on quit:
    clear_countdown("%uuid of player%")

# ============================================
# 手動取消
# ============================================
command /取消傳送:
    aliases: /tpcancel
    trigger:
        if {countdown::%uuid of player%} is true:
            send "{@prefix} &c傳送已取消！" to player
            send action bar "&c&l✗ 傳送已取消" to player
            play sound "BLOCK_NOTE_BLOCK_BASS" with volume 0.5 to player
            clear_countdown("%uuid of player%")
        else:
            send "{@prefix} &7沒有正在進行的傳送" to player
